rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only signed-in family members (email + password accounts). Accounts are created by the owner in
    // Firebase Console → Authentication → Users; public sign-up is disabled there.
    // Any collection is allowed, so new app features don't need a rules change.
    function signedIn() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'password';
    }

    // View-only users (e.g. grandparents): roles/{uid} = { role: 'viewer' }, set in the app (Settings → users).
    function isViewer() {
      return exists(/databases/$(database)/documents/roles/$(request.auth.uid))
        && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'viewer';
    }

    match /{collection}/{id} {
      allow read: if signedIn();
      // Viewers can't change anything, except their own display name.
      allow write: if signedIn() && (!isViewer() || (collection == 'profiles' && id == request.auth.uid));
    }
  }
}
