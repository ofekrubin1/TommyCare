{
  "name": "tommycare",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host --port 5174 --strictPort",
    "dev:local": "vite --mode localdb --host --port 5173 --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "check-gmail": "node scripts/check-gmail.mjs",
    "deploy": "vite build && firebase deploy --only hosting && wrangler pages deploy cloudflare/public --project-name tommycare --branch main",
    "deploy:cron": "wrangler deploy --config workers/cron/wrangler.toml",
    "deploy:rules": "firebase deploy --only firestore:rules"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "date-fns": "3.6.0",
    "firebase": "10.14.1",
    "html2canvas": "1.4.1",
    "jspdf": "2.5.2",
    "lucide-react": "0.468.0",
    "nodemailer": "6.9.16",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "tailwind-merge": "2.5.5",
    "worker-mailer": "1.2.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "firebase-tools": "15.32.1",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.16",
    "vite": "5.4.11",
    "wrangler": "4.148.0"
  }
}
